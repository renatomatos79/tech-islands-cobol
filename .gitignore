# ===== COBOL / Build outputs =====
**/bin/
**/build/
**/*.o
**/*.obj
**/*.exe
**/*.so
**/*.dll
**/*.a
**/*.out

# GnuCOBOL generated C files (if any)
**/*.c
**/*.i

# Temporary files used by your programs
**/tmp/
**/*.tmp
**/*.log

# ===== Docker =====
.docker/
docker-compose.override.yml
**/.env

# ===== Node / API layer (if you add it later) =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ===== VS Code =====
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json

# ===== macOS junk =====
.DS_Store
.AppleDouble
.LSOverride
._*

# ===== Linux junk =====
*~
*.swp
*.swo

# ===== Optional: ignore everything inside day folders EXCEPT source =====
day-*/bin/
day-*/tmp/
day-*/build/
